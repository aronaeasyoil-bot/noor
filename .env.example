# Copy to .env.local (Next.js dev) or .dev.vars (wrangler). Never commit real values.
# On Cloudflare, set each secret with: npx wrangler secret put NAME [--env preview]

# Public URL of the site (used in emails and payment return links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL (Neon, Supabase, RDS…). On Cloudflare prefer a Hyperdrive binding; DATABASE_URL is the fallback.
DATABASE_URL=postgres://user:password@host:5432/noor

# First super admin, used only by `npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Payments (Stripe Checkout hosted page). Without both, bookings stay "requested" and no card is ever taken.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email (Resend). Without it, no email is claimed to be sent.
RESEND_API_KEY=
EMAIL_FROM="NOOR Travel & Tours <bookings@your-domain>"
OPS_EMAIL=

# Flights supplier (Amadeus). Leave empty until NOOR has credentials; searches are then sent to advisers.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Optional: LLM for the assistant (answers only from the admin knowledge base)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5

# Exchange rates: default provider is open.er-api.com (base AED). Optional override.
EXCHANGE_RATE_URL=
# Bearer token for POST /api/cron/rates
CRON_SECRET=

# Local development only: allow the session cookie over http://
INSECURE_COOKIES=
